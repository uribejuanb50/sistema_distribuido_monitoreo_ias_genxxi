  "tablas": [
    {
      "nombre": "semanas",
      "_comentario": "Semana N = días 7(N-1)+1 a 7N del mes (las 4 semanas suman exactamente el total). Una semana sin terminar solo envía razones (%, TMO), no conteos.",
      "tipo": "semanal",
      "encabezados_requeridos": ["Semana Mes"],
      "columnas": {"Acciones": "acciones_llamada", "Sesiones": "sesiones_llamada", "%Usabilidad": "usabilidad",
                   "TMO/TPA": "tmo", "%FCR": "fcr", "%NPS": "nps", "Var_Sesiones %": null},
      "metricas_conteo": ["acciones_llamada", "sesiones_llamada"],
      "total_a_mes": ["tmo", "fcr", "nps"]
    },
    {
      "nombre": "gerencias_viki",
      "tipo": "dimension",
      "dimension": "gerencia",
      "encabezados_requeridos": ["Gerencia", "Usuarios"],
      "columnas": {"Usuarios": "usuarios", "Sesiones": "sesiones", "Acciones": "acciones", "Acc_x_Sesion": "acciones_x_sesion"}
    },
    {
      "nombre": "gerencias_contactos",
      "tipo": "dimension",
      "dimension": "gerencia",
      "encabezados_requeridos": ["Gerencia", "%Usabilidad"],
      "columnas": {"%Usabilidad": "usabilidad", "Sesiones": "sesiones_llamada", "Acciones": "acciones_llamada",
                   "Acc_x_Sesion": "acciones_x_sesion_llamada", "TMO/TPA": "tmo", "%NPS": "nps", "%FCR": "fcr"}
    },
    {
      "nombre": "ubicaciones_viki",
      "tipo": "dimension",
      "dimension": "ubicacion",
      "encabezados_requeridos": ["Ubicación", "Usuarios"],
      "columnas": {"Usuarios": "usuarios", "Sesiones": "sesiones", "Acciones": "acciones", "Acc_x_Sesion": "acciones_x_sesion"}
    },
    {
      "nombre": "ubicaciones_contactos",
      "tipo": "dimension",
      "dimension": "ubicacion",
      "encabezados_requeridos": ["Ubicación", "%Usabilidad"],
      "columnas": {"%Usabilidad": "usabilidad", "Sesiones": "sesiones_llamada", "Acciones": "acciones_llamada",
                   "Acc_x_Sesion": "acciones_x_sesion_llamada", "TMO/TPA": "tmo", "%NPS": "nps", "%FCR": "fcr"}
    }
  ],

  "graficos": [
    {
      "nombre": "acciones_por_antiguedad",
      "_comentario": "Serie 1 suma exactamente el total de acciones (verificado). Las series 2 y 3 no se identificaron con certeza: no se envían.",
      "dimension": "antiguedad",
      "patron_categoria": "^\\d\\)\\s",
      "series": ["acciones", null, null],
      "validar_suma": {"acciones": "total.acciones"}
    }
  ],

  "excluir_encabezados": {
    "_comentario": "Visuales con estos encabezados NO se leen: tienen datos por persona (usuario, nombre).",
    "encabezados": ["Usuario", "Nombre"]
  },

  "validaciones": {
    "suma_segmentos": {
      "total": "total",
      "partes": ["presencial", "telefonico"],
      "metricas": ["usuarios", "sesiones", "acciones", "usuarios_llamada", "llamadas_turnos",
                   "sesiones_llamada", "acciones_llamada"]
    },
    "cocientes": {
      "segmentos": ["total", "presencial", "telefonico"],
      "reglas": [
        {"resultado": "acciones_x_sesion", "numerador": "acciones", "denominador": "sesiones", "factor": 1},
        {"resultado": "acciones_x_sesion_llamada", "numerador": "acciones_llamada", "denominador": "sesiones_llamada", "factor": 1},
        {"resultado": "usabilidad", "numerador": "sesiones_llamada", "denominador": "llamadas_turnos", "factor": 100}
      ]
    }
  },

  "metas": {
    "_comentario": "Opcional: meta vigente por kpi_id, p. ej. \"viki.semanal.nps\": 65. Sin meta, el cerebro no evalúa cumplimiento."
  }
}
