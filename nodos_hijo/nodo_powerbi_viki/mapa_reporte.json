    "antiguedad_meses":          {"nombre": "Antigüedad promedio (meses)", "unidad": "unidades", "decimales": 1},
    "usabilidad":                {"nombre": "% Usabilidad (sesiones con llamada / llamadas)", "unidad": "porcentaje", "decimales": 1},
